{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm:*)",
      "Bash(node --test:*)",
      "Bash(node src/calculator.js:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny":[
      "Read(./.env)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/test-on-src-change.js"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
