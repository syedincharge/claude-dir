{
  "name": "claude-dir-calculator",
  "version": "1.0.0",
  "description": "Calculator demo for the Agentic AI for Software Developer course",
  "private": true,
  "license": "MIT",
  "main": "src/calculator.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:report": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml \"test/*.test.js\"",
    "test:browser": "node scripts/browser-test.js",
    "test:browser:watch": "node scripts/browser-test.js --headed",
    "report": "npm run test:report && npm run test:browser"
  },
  "engines": {
    "node": ">=18"
  }
}
